/* Painel do construtor — mesma família visual do construtor em HTML (tema escuro da barra lateral). */

/* Paleta do jogo: todas as cores repetidas vêm daqui. Mude uma vez e vale para a interface inteira. */
:root {
    --texto: rgb(229, 235, 227);
    --texto-fraco: rgb(148, 161, 151);
    --destaque: rgb(245, 194, 27);
    --sobre-destaque: rgb(27, 22, 0);
    --alerta: rgb(240, 122, 58);
    --ok: rgb(61, 190, 116);
    --verde-luz: rgb(43, 193, 103);
    --trilho-a: rgb(240, 74, 63);
    --trilho-b: rgb(80, 137, 242);
    --trilho-c: rgb(56, 186, 98);
    --trilho-d: rgb(242, 183, 40);
    --trilho-e: rgb(139, 63, 217);
    --trilho-f: rgb(25, 181, 201);
    --trilho-g: rgb(240, 120, 30);
    --trilho-h: rgb(224, 72, 150);
    --fundo: rgb(22, 28, 25);
    --fundo-vidro: rgba(22, 28, 25, 0.94);
    --fundo-painel: rgba(22, 28, 25, 0.97);
    --fundo-fundo: rgb(16, 21, 19);
    --fundo-campo: rgb(30, 38, 34);
    --botao: rgb(46, 56, 51);
    --borda: rgb(41, 50, 45);
    --borda-media: rgb(53, 65, 59);
    --borda-clara: rgb(58, 70, 64);
    --borda-hover: rgb(90, 107, 98);
    --tinta-mesa: rgb(24, 32, 28);
    --borda-mesa: rgb(207, 215, 204);
}

.root { flex-grow: 1; }

/* ---------- Barra lateral ---------- */
.side {
    position: absolute; left: 0; top: 0; bottom: 0; width: 340px;
    background-color: var(--fundo-painel);
    border-right-width: 1px; border-color: var(--borda);
}
.side-scroll { flex-grow: 1; }
.side-content { padding: 14px 16px 28px 16px; }

.title-row { flex-direction: row; align-items: center; justify-content: space-between; }
.titles { flex-shrink: 1; flex-grow: 1; margin-right: 8px; }
.title { font-size: 18px; -unity-font-style: bold; color: var(--texto); margin: 0; padding: 0; white-space: normal; }
.subtitle { font-size: 10px; color: var(--texto-fraco); letter-spacing: 1px; margin: 0; padding: 0; }

.status {
    flex-direction: row; align-items: center; align-self: flex-start;
    margin-top: 10px; padding: 6px 12px; border-radius: 14px;
    background-color: rgb(31, 39, 35); border-width: 1px; border-color: var(--botao);
}
.status-dot { width: 9px; height: 9px; border-radius: 5px; margin-right: 8px; background-color: var(--destaque); }
.status-text { font-size: 13px; -unity-font-style: bold; color: var(--texto); white-space: normal; margin: 0; padding: 0; }
.status--ok .status-dot { background-color: var(--ok); }
.status--ok .status-text { color: var(--ok); }
.status--warn .status-dot { background-color: var(--alerta); }
.status--warn .status-text { color: var(--alerta); }

.section { margin-top: 16px; padding-top: 12px; border-top-width: 1px; border-color: var(--borda); }
.h2 { font-size: 13px; -unity-font-style: bold; color: var(--destaque); letter-spacing: 2px; margin: 0 0 8px 0; padding: 0; }
.hint { font-size: 12px; color: var(--texto-fraco); white-space: normal; margin: 0 0 8px 0; padding: 0; }
.body { font-size: 13px; color: var(--texto); white-space: normal; margin: 0; padding: 0; }
.small { font-size: 11px; color: var(--texto-fraco); white-space: normal; margin: 0; padding: 0; }
.row { flex-direction: row; flex-wrap: wrap; }

/* ---------- Paleta ---------- */
.palette { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.tile {
    width: 49%; height: 54px; flex-direction: row; align-items: center;
    margin: 0 0 6px 0; padding: 4px 6px;
    background-color: var(--fundo-campo); border-width: 1px; border-color: var(--botao); border-radius: 8px;
}
.tile:hover { border-color: var(--destaque); background-color: rgb(42, 43, 28); }
.tile-icon { width: 40px; height: 40px; flex-shrink: 0; }
.tile-texts { flex-grow: 1; flex-shrink: 1; margin-left: 6px; }
.tile-name { font-size: 11px; -unity-font-style: bold; color: var(--texto); white-space: normal; margin: 0; padding: 0; }
.tile-sub { font-size: 11px; color: var(--texto-fraco); margin: 0; padding: 0; }
.key {
    position: absolute; right: 5px; top: 4px; font-size: 10px; color: var(--texto-fraco);
    border-width: 1px; border-color: rgb(58, 71, 64); border-radius: 4px; padding: 0 4px; margin: 0;
}

/* ---------- Botões ---------- */
.btn {
    height: 28px; padding: 0 10px; margin: 0 6px 6px 0; font-size: 12px; -unity-font-style: bold;
    color: var(--texto); background-color: rgb(34, 43, 39);
    border-width: 1px; border-color: var(--borda-media); border-radius: 6px;
}
.btn:hover { border-color: var(--borda-hover); background-color: rgb(40, 50, 45); }
.btn:disabled { opacity: 0.4; }
.btn--primary { background-color: var(--texto); color: var(--fundo); border-color: var(--texto); }
.btn--primary:hover { background-color: rgb(255, 255, 255); }
.btn--danger { color: var(--alerta); }
.btn--on { background-color: var(--destaque); color: var(--sobre-destaque); border-color: var(--destaque); }
.icon-btn { width: 30px; height: 28px; padding: 0; margin: 0; }

/* ---------- Peça selecionada ---------- */
.sel-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.sel-icon { width: 42px; height: 42px; margin-right: 10px; flex-shrink: 0; }
.sel-texts { flex-shrink: 1; flex-grow: 1; }
.segmented { flex-direction: row; align-items: center; margin-top: 2px; }
.segmented .btn { margin-right: 4px; }
.seg-label { font-size: 11px; color: var(--texto-fraco); width: 48px; margin: 0; padding: 0; }

/* ---------- Resumo ---------- */
.stats-row { flex-direction: row; justify-content: space-between; margin-bottom: 3px; }
.stats-key { font-size: 12px; color: var(--texto-fraco); margin: 0; padding: 0; }
.stats-val { font-size: 12px; color: var(--texto); -unity-text-align: middle-right; margin: 0; padding: 0; }
.swatch { width: 9px; height: 9px; border-radius: 2px; margin-right: 6px; }
.swatch--a { background-color: var(--trilho-a); }
.swatch--b { background-color: var(--trilho-b); }
.swatch--c { background-color: var(--trilho-c); }
.swatch--d { background-color: var(--trilho-d); }
.swatch--e { background-color: var(--trilho-e); }
.swatch--f { background-color: var(--trilho-f); }
.swatch--g { background-color: var(--trilho-g); }
.swatch--h { background-color: var(--trilho-h); }

/* ---------- Sequência ---------- */
.seq { flex-direction: row; flex-wrap: wrap; }
.chip {
    width: 38px; height: 44px; margin: 0 4px 4px 0; padding: 2px;
    background-color: var(--fundo-campo); border-width: 1px; border-color: var(--botao); border-radius: 6px;
    align-items: center; justify-content: center;
}
.chip:hover { border-color: var(--borda-hover); }
.chip--on { border-color: var(--destaque); background-color: rgb(58, 53, 23); }
.chip--bad { border-color: var(--alerta); }
.chip-icon { width: 22px; height: 22px; }
.chip-num { font-size: 10px; color: var(--texto-fraco); -unity-text-align: middle-center; margin: 0; padding: 0; }

/* ---------- Minhas pistas ---------- */
.name-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.name-field { flex-grow: 1; margin: 0 6px 0 0; }
.name-field .unity-text-field__input, .name-field .unity-base-text-field__input {
    background-color: var(--fundo-fundo); border-color: var(--borda-media); color: var(--texto);
    border-radius: 6px; font-size: 13px; padding: 4px 8px; min-height: 28px;
}
.lib-item {
    flex-direction: row; align-items: center; padding: 6px; margin-bottom: 6px;
    background-color: var(--fundo-campo); border-width: 1px; border-color: var(--botao); border-radius: 8px;
}
.lib-item--on { border-color: var(--destaque); }
.thumb { width: 56px; height: 42px; margin-right: 8px; background-color: var(--fundo-fundo); border-radius: 5px; flex-shrink: 0; }
.lib-texts { flex-grow: 1; flex-shrink: 1; }
.lib-name { font-size: 13px; -unity-font-style: bold; color: var(--texto); overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0; }
.lib-item .btn { margin: 0 0 0 4px; height: 24px; padding: 0 8px; font-size: 11px; }
.bad { color: var(--alerta); }

/* ---------- Sobre a mesa ---------- */
.show-tab { position: absolute; left: 10px; top: 10px; }
.ruler-top {
    position: absolute; top: 0; right: 0; height: 20px;
    background-color: rgba(248, 250, 246, 0.92); border-bottom-width: 1px; border-color: var(--borda-mesa);
}
.ruler-left {
    position: absolute; top: 20px; bottom: 0; width: 26px;
    background-color: rgba(248, 250, 246, 0.92); border-right-width: 1px; border-color: var(--borda-mesa);
}
.ruler-label {
    position: absolute; width: 24px; height: 16px; font-size: 10px; color: rgb(91, 103, 95);
    -unity-text-align: middle-center; margin: 0; padding: 0;
}
.ruler-top .ruler-label { top: 2px; }
.ruler-left .ruler-label { left: 1px; }
.ruler-label--on { background-color: rgb(233, 168, 0); color: var(--sobre-destaque); border-radius: 3px; }

.info {
    position: absolute; bottom: 10px; flex-direction: row; align-items: center; padding: 5px 10px;
    background-color: rgba(248, 250, 246, 0.95); border-radius: 6px; border-width: 1px; border-color: var(--borda-mesa);
}
.info-text { font-size: 12px; color: var(--tinta-mesa); margin: 0 12px 0 0; padding: 0; }
.scale-bar { height: 6px; border-left-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-color: var(--tinta-mesa); margin-right: 6px; }
.scale-text { font-size: 12px; color: var(--tinta-mesa); margin: 0; padding: 0; }

.view-badge {
    position: absolute; top: 54px; right: 12px; padding: 5px 10px; border-radius: 6px;
    background-color: rgba(22, 28, 25, 0.9); color: var(--texto); font-size: 12px;
}
.toast {
    position: absolute; bottom: 12px; right: 16px; padding: 8px 14px; border-radius: 8px;
    background-color: var(--fundo); color: var(--texto); font-size: 13px;
}

/* ---------- Abas ---------- */
.tabs { flex-direction: row; margin-top: 10px; padding: 3px; border-radius: 8px; background-color: var(--fundo-fundo); border-width: 1px; border-color: var(--botao); }
.tab {
    flex-grow: 1; flex-shrink: 1; height: 28px; margin: 0; padding: 0; border-width: 0; border-radius: 6px; font-size: 10px; -unity-font-style: bold;
    letter-spacing: 0; color: var(--texto-fraco); background-color: rgba(0, 0, 0, 0);
}
.tab:hover { color: var(--texto); }
.tab--on { background-color: var(--texto); color: var(--fundo); }
.tab--on:hover { color: var(--fundo); }

/* ---------- Corrida: barra lateral ---------- */
.pick { height: auto; -unity-text-align: middle-left; }
.pick:disabled { opacity: 0.45; }
.clock { font-size: 15px; -unity-font-style: bold; color: var(--texto); margin: 0; padding: 0; }
.score { margin-top: 8px; }
.score-row { flex-direction: row; padding: 5px 0; border-top-width: 1px; border-color: var(--borda); }
.score-head { border-top-width: 0; }
.score-cell { width: 15%; font-size: 12px; color: var(--texto); -unity-text-align: middle-right; margin: 0; padding: 0; }
.score-cell--name { width: 25%; -unity-text-align: middle-left; }
.score-head .score-cell { font-size: 10px; color: var(--texto-fraco); letter-spacing: 1px; }
.score-a .score-cell--name { color: var(--trilho-a); -unity-font-style: bold; }
.score-b .score-cell--name { color: var(--trilho-b); -unity-font-style: bold; }
.score-c .score-cell--name { color: var(--trilho-c); -unity-font-style: bold; }
.score-d .score-cell--name { color: var(--trilho-d); -unity-font-style: bold; }
.score-e .score-cell--name { color: var(--trilho-e); -unity-font-style: bold; }
.score-f .score-cell--name { color: var(--trilho-f); -unity-font-style: bold; }
.score-g .score-cell--name { color: var(--trilho-g); -unity-font-style: bold; }
.score-h .score-cell--name { color: var(--trilho-h); -unity-font-style: bold; }
.score-win .score-cell { -unity-font-style: bold; }
.setting { margin: 0 0 8px 0; }
.setting .unity-label { color: var(--texto); font-size: 12px; min-width: 150px; }
.setting .unity-base-slider__dragger { background-color: var(--destaque); border-color: var(--destaque); }

/* ---------- Corrida: sobre a mesa ---------- */
.race-top { position: absolute; top: 12px; left: 0; right: 0; align-items: center; }
.lights { flex-direction: row; padding: 8px 10px; border-radius: 10px; background-color: rgb(14, 17, 16); }
.light { width: 26px; height: 26px; margin: 0 4px; border-radius: 13px; background-color: rgb(42, 47, 45); }
.light--red { background-color: rgb(224, 55, 44); }
.light--green { background-color: var(--verde-luz); }
.banner { align-items: center; padding: 10px 20px; border-radius: 12px; background-color: var(--fundo-vidro); }
.banner-title { font-size: 24px; -unity-font-style: bold; color: var(--texto); letter-spacing: 1px; margin: 0; padding: 0; }
.banner-title--a { color: var(--trilho-a); }
.banner-title--b { color: var(--trilho-b); }
.banner-title--c { color: var(--trilho-c); }
.banner-title--d { color: var(--trilho-d); }
.banner-title--e { color: var(--trilho-e); }
.banner-title--f { color: var(--trilho-f); }
.banner-title--g { color: var(--trilho-g); }
.banner-title--h { color: var(--trilho-h); }
.banner-sub { font-size: 13px; color: var(--texto-fraco); margin: 4px 0 0 0; padding: 0; }

.pads { position: absolute; bottom: 12px; right: 12px; flex-direction: row; }
.pad {
    flex-grow: 1; flex-basis: 0; margin-right: 12px; padding: 8px 10px 10px 10px; border-radius: 12px;
    background-color: var(--fundo-vidro); border-top-width: 4px; border-color: var(--trilho-a);
}
.pad--b { border-color: var(--trilho-b); }
.pad--c { border-color: var(--trilho-c); }
.pad--d { border-color: var(--trilho-d); }
.pad--e { border-color: var(--trilho-e); }
.pad--f { border-color: var(--trilho-f); }
.pad--g { border-color: var(--trilho-g); }
.pad--h { border-color: var(--trilho-h); }
.pad--last { margin-right: 0; }
.pad-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.pad-name { font-size: 14px; -unity-font-style: bold; letter-spacing: 1px; color: var(--texto); margin: 0; padding: 0; }
.pad-state { font-size: 12px; color: var(--texto-fraco); margin: 0; padding: 0; }
.pad-state--alert { color: var(--alerta); -unity-font-style: bold; }
.pad-body { flex-direction: row; }
.gas {
    flex-grow: 1; height: 84px; margin-right: 10px; border-radius: 10px; overflow: hidden;
    background-color: var(--fundo-fundo); border-width: 2px; border-color: var(--trilho-a); justify-content: center; align-items: center;
}
.pad--b .gas { border-color: var(--trilho-b); }
.pad--c .gas { border-color: var(--trilho-c); }
.pad--d .gas { border-color: var(--trilho-d); }
.pad--e .gas { border-color: var(--trilho-e); }
.pad--f .gas { border-color: var(--trilho-f); }
.pad--g .gas { border-color: var(--trilho-g); }
.pad--h .gas { border-color: var(--trilho-h); }
.gas-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: rgba(240, 74, 63, 0.35); }
.pad--b .gas-fill { background-color: rgba(80, 137, 242, 0.35); }
.pad--c .gas-fill { background-color: rgba(56, 186, 98, 0.35); }
.pad--d .gas-fill { background-color: rgba(242, 183, 40, 0.35); }
/* Tela dividida: cada painel no pé do quadro do seu jogador (posição em RaceController.Split). */
.pads--split { left: 0; right: 0; top: 0; bottom: 0; }
.pads--split .pad { margin: 0 12px 12px 12px; }
.cam-split { margin-top: 6px; }
.pane-cam { position: absolute; margin-right: 12px; border-top-width: 3px; }
/* Pista de 4 carros: quatro painéis mais baixos e estreitos. */
.pads--4 .pad { margin-right: 8px; padding: 6px 8px 8px 8px; }
.pads--4 .pad--last { margin-right: 0; }
.pads--4 .gas { height: 58px; margin-right: 8px; }
.pads--4 .gas-text { font-size: 12px; letter-spacing: 1px; white-space: normal; -unity-text-align: middle-center; }
.pads--4 .pad-side { width: 104px; }
.pads--4 .pad-name { font-size: 12px; }
/* Pista de 6 carros: seis painéis lado a lado, ainda mais compactos (sem a legenda dos medidores). */
.pads--6 .pad { margin-right: 5px; padding: 4px 6px 6px 6px; border-top-width: 3px; }
.pads--6 .pad--last { margin-right: 0; }
.pads--6 .pad-head { margin-bottom: 3px; }
.pads--6 .pad-name { font-size: 10px; letter-spacing: 0; }
.pads--6 .pad-state { font-size: 10px; }
.pads--6 .pad-body { flex-direction: column; }
.pads--6 .gas { height: 40px; margin-right: 0; margin-bottom: 4px; border-width: 1px; }
.pads--6 .gas-text { font-size: 10px; letter-spacing: 0; white-space: normal; -unity-text-align: middle-center; }
.pads--6 .pad-side { width: auto; }
.pads--6 .meter-label { display: none; }
.pads--6 .meter { height: 5px; margin-bottom: 3px; }
.pads--6 .reslot { height: 22px; font-size: 10px; margin: 0; padding: 0; }
.hud--6 .hud-card { min-width: 0; margin: 0 2px; padding: 4px 8px 4px 4px; }
.hud--6 .hud-pos { width: 22px; font-size: 14px; }
.hud--6 .hud-name { font-size: 10px; letter-spacing: 0; }
.hud--6 .hud-lap { font-size: 10px; margin-right: 6px; }
.hud--6 .hud-best { display: none; }
/* Pista de 8 carros: oito painéis e oito fichas, mais apertados ainda. */
.pads--8 .pad { margin-right: 3px; padding: 3px 4px 5px 4px; }
.pads--8 .gas { height: 34px; }
.pads--8 .gas-text { font-size: 9px; }
.hud--8 .hud-card { margin: 0 1px; padding: 3px 5px 3px 3px; }
.hud--8 .hud-pos { width: 18px; font-size: 12px; }
.hud--8 .hud-lap { margin-right: 3px; }
.pad--held .gas { background-color: rgb(30, 36, 33); }
.gas-text { font-size: 18px; -unity-font-style: bold; letter-spacing: 2px; color: var(--texto); margin: 0; padding: 0; }
.pad-side { width: 150px; }
.meter-label { font-size: 11px; color: var(--texto-fraco); margin: 0 0 2px 0; padding: 0; }
.meter { height: 8px; margin-bottom: 6px; border-radius: 4px; background-color: var(--fundo-fundo); border-width: 1px; border-color: var(--borda-media); overflow: hidden; }
.meter-fill { height: 100%; width: 0; background-color: var(--texto); }
.reslot { margin: 2px 0 0 0; }
.reslot--ready { background-color: var(--destaque); color: var(--sobre-destaque); border-color: var(--destaque); }

/* ---------- Fechar circuito ---------- */
.close-btn { align-self: flex-start; margin: 8px 0 0 0; height: 30px; }
.close-box { margin: 8px 0 0 0; }
.close-box .meter { height: 10px; margin-bottom: 6px; }
.close-box .meter-fill { background-color: var(--destaque); }
.btn--accent { background-color: var(--destaque); color: var(--sobre-destaque); border-color: var(--destaque); }
.btn--accent:hover { background-color: rgb(255, 210, 60); }
.toast { max-width: 520px; white-space: normal; }

/* ---------- Campeonato ---------- */
.h3 { font-size: 11px; -unity-font-style: bold; color: var(--texto-fraco); letter-spacing: 1px; margin: 10px 0 6px 0; padding: 0; }
.plan { margin: 10px 0 8px 0; }
.ok { color: var(--ok); }
.ptag {
    font-size: 10px; -unity-font-style: bold; letter-spacing: 0.5px; margin: 0 4px 0 0; padding: 1px 4px;
    border-radius: 3px; -unity-text-align: middle-center; flex-shrink: 0;
}
.pdot { width: 10px; height: 10px; border-radius: 5px; margin-right: 6px; flex-shrink: 0; }
.aib {
    font-size: 10px; color: var(--texto-fraco); margin: 0 4px 0 0; padding: 1px 4px;
    border-width: 1px; border-color: var(--borda-hover); border-radius: 3px; flex-shrink: 0;
}
.prow {
    flex-direction: row; align-items: center; padding: 5px 6px; margin-bottom: 6px;
    background-color: var(--fundo-campo); border-width: 1px; border-color: var(--botao); border-radius: 8px;
}
.prow--on { border-color: var(--texto); }
.prow-check { margin: 0 6px 0 0; }
.prow-info { flex-direction: row; flex-wrap: wrap; align-items: center; flex-grow: 1; flex-shrink: 1; }
.prow-info .small { margin-right: 4px; }
.prow-name { font-size: 13px; -unity-font-style: bold; color: var(--texto); margin: 0 6px 0 0; padding: 0; }
.prow-acts { flex-direction: row; flex-shrink: 0; }
.prow-acts .btn { height: 22px; padding: 0 6px; margin: 0 0 0 4px; font-size: 11px; }
.pform { padding: 2px 10px 10px 10px; border-width: 1px; border-color: var(--borda-media); border-radius: 8px; }
.pf-row { flex-direction: row; margin-bottom: 8px; }
.pf-name { flex-grow: 1; }
.pf-tag { width: 64px; flex-grow: 0; margin-right: 0; }
.swatches { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.swatch { width: 24px; height: 24px; padding: 0; margin: 0 6px 6px 0; border-radius: 12px; border-width: 2px; border-color: var(--fundo); }
.swatch--on { border-color: var(--texto); }
.swatch--used { opacity: 0.35; }
.ai-toggle .unity-label { min-width: 0; -unity-font-style: bold; }
.stage-ctl { align-items: flex-end; flex-shrink: 0; }
.stepper { flex-direction: row; align-items: center; margin-bottom: 4px; }
.step-btn { width: 22px; height: 22px; padding: 0; margin: 0 0 0 3px; font-size: 12px; }
.lib-item .step-btn { margin: 0 0 0 3px; height: 22px; padding: 0; }
.step-val { font-size: 11px; color: var(--texto); width: 58px; -unity-text-align: middle-center; margin: 0; padding: 0; }
.pick-plus { font-size: 18px; color: var(--texto-fraco); margin: 0 4px 0 0; padding: 0; }

.heat { padding: 8px; margin-bottom: 8px; border-radius: 8px; background-color: var(--fundo-campo); border-width: 1px; border-color: var(--botao); }
.heat-stage { font-size: 10px; letter-spacing: 1px; color: var(--texto-fraco); margin: 0 0 6px 0; padding: 0; }
.vs { flex-direction: row; align-items: center; }
.vs--4 { flex-wrap: wrap; }
.vs--6 { flex-wrap: wrap; }
.vs--6 .hp { flex-basis: 30%; margin: 0 4px 4px 0; }
.vs--8 .hp { flex-basis: 22%; }
.hp--empty { opacity: 0.45; border-left-color: var(--borda-media); }
.vs--4 .hp { flex-basis: 45%; margin: 0 4px 4px 0; }
.vs-x { font-size: 14px; color: var(--texto-fraco); margin: 0 6px; padding: 0; }
.hp { flex-grow: 1; flex-basis: 0; padding: 4px 6px; border-radius: 6px; background-color: var(--fundo); border-left-width: 4px; }
.hp-name { font-size: 15px; -unity-font-style: bold; color: var(--texto); margin: 1px 0; padding: 0; overflow: hidden; text-overflow: ellipsis; }

.stand { margin-top: 2px; }
.st-row { flex-direction: row; align-items: center; padding: 4px 0; border-top-width: 1px; border-color: var(--borda); }
.st-head { border-top-width: 0; }
.st-cell { width: 34px; font-size: 12px; color: var(--texto); -unity-text-align: middle-right; margin: 0; padding: 0; flex-shrink: 0; }
.st-head .st-cell { font-size: 10px; color: var(--texto-fraco); letter-spacing: 1px; }
.st-cell--name { flex-grow: 1; flex-shrink: 1; width: auto; flex-direction: row; align-items: center; -unity-text-align: middle-left; overflow: hidden; }
.st-pos { width: 18px; -unity-text-align: middle-left; }
.st-time { width: 58px; }
.st-pts { -unity-font-style: bold; }
.st-star { color: var(--destaque); }
.st-label { width: 62px; -unity-text-align: middle-left; color: var(--texto-fraco); }
.st-name { font-size: 12px; color: var(--texto); margin: 0 4px 0 0; padding: 0; overflow: hidden; text-overflow: ellipsis; }
.st-lead { background-color: rgba(245, 194, 27, 0.10); }
.st-up { font-size: 10px; color: var(--ok); margin: 0; padding: 0; }
.st-down { font-size: 10px; color: var(--alerta); margin: 0; padding: 0; }

.podium { flex-direction: row; align-items: flex-end; margin: 4px 0 10px 0; }
.pod { flex-grow: 1; flex-basis: 0; margin: 0 3px; padding: 6px 4px; border-radius: 8px; align-items: center; background-color: var(--fundo-campo); border-top-width: 4px; }
.pod--1 { padding-top: 16px; }
.pod-place { font-size: 20px; -unity-font-style: bold; color: var(--texto); margin: 0; padding: 0; }
.pod-name { font-size: 12px; -unity-font-style: bold; color: var(--texto); margin: 0; padding: 0; }
.award { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 4px; }
.award-label { font-size: 12px; color: var(--texto-fraco); width: 116px; margin: 0; padding: 0; }
/* Corrida: cartões de piloto (um por carro), contagem de carros e seções recolhidas (seção 33 do guia). */
.pcard { margin: 0 0 6px 0; padding: 6px 8px; background-color: var(--fundo); border-left-width: 4px; border-color: var(--borda-media); }
.pcard-head { flex-direction: row; align-items: center; justify-content: space-between; }
.pcard-name { font-size: 13px; -unity-font-style: bold; color: var(--texto); margin: 0; padding: 0; }
.pcard-seg { margin-top: 0; }
.pcard-seg .btn { height: 24px; font-size: 11px; margin-bottom: 0; }
.pcard-skill { margin: 6px 0 2px 0; }
.pcard .small { margin-top: 4px; }
.car-count { flex-grow: 1; flex-basis: 0; min-width: 0; }
.fold > .unity-foldout__toggle { margin: 0; }
.fold .unity-foldout__text { color: var(--destaque); font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; }
.fold .unity-foldout__content { margin-left: 0; margin-top: 8px; }
.hist { margin-bottom: 6px; }
.hist .unity-foldout__text { color: var(--texto); font-size: 12px; }

.pad-state--rec { background-color: var(--destaque); color: var(--sobre-destaque); -unity-font-style: bold; padding: 1px 5px; border-radius: 4px; }
.pad-state--pb { color: var(--ok); -unity-font-style: bold; }
.gas--ai { border-color: var(--borda-hover); }
.gas--ai .gas-text { font-size: 14px; color: var(--texto-fraco); }

/* ---------- Online: lobby ---------- */
.chat-log {
    height: 180px; padding: 4px 6px; background-color: var(--fundo-fundo); border-width: 1px; border-color: var(--borda-media); border-radius: 6px;
}
.chat-line { font-size: 12px; color: var(--texto); white-space: normal; margin: 0 0 3px 0; padding: 0; }

/* Menu da câmera (corrida): botão no canto superior direito, a lista abre embaixo */
.cam-menu { position: absolute; top: 10px; right: 12px; align-items: flex-end; }
/* Minimapa da corrida: janela solta sobre a mesa (posição e tamanho são calculados em RaceMinimap). */
.minimap { position: absolute; background-color: var(--fundo-vidro); border-radius: 12px; border-width: 1px; border-color: var(--borda); overflow: hidden; }
.minimap-head { flex-direction: row; justify-content: space-between; align-items: center; height: 24px; padding: 0 10px; background-color: rgba(255, 255, 255, 0.05); cursor: move; }
.minimap-title { font-size: 10px; letter-spacing: 1px; -unity-font-style: bold; color: var(--texto-fraco); margin: 0; padding: 0; }
.minimap-hint { font-size: 10px; color: var(--texto-fraco); margin: 0; padding: 0; }
.minimap-canvas { position: relative; }
.minimap-grip { position: absolute; right: 0; bottom: 0; width: 16px; height: 16px; background-color: rgba(255, 255, 255, 0.18); border-radius: 4px; }
.minimap-toggle { height: 26px; padding: 0 12px; font-size: 12px; -unity-font-style: bold; color: var(--texto); -unity-text-align: middle-left; border-top-width: 1px; border-color: var(--borda); }
.minimap-info { display: none; border-top-width: 1px; border-color: var(--borda); padding: 4px 0; max-height: 300px; overflow: hidden; }
.minimap-row { padding: 4px 10px; }
.minimap-row-top { flex-direction: row; align-items: center; }
.minimap-dot { width: 9px; height: 9px; border-radius: 5px; margin-right: 6px; }
.minimap-pos { font-size: 12px; -unity-font-style: bold; color: var(--texto-fraco); width: 26px; margin: 0; padding: 0; }
.minimap-name { font-size: 11px; -unity-font-style: bold; color: var(--texto); flex-grow: 1; margin: 0; padding: 0; }
.minimap-lap { font-size: 10px; color: var(--destaque); margin: 0; padding: 0; }
.minimap-stats { font-size: 10px; color: var(--texto-fraco); white-space: normal; margin: 2px 0 0 0; padding: 0 0 0 15px; }
.cam-btn { height: 34px; padding: 0 14px; background-color: var(--fundo-vidro); font-size: 13px; }
.cam-btn--open { border-color: var(--destaque); }
.cam-pop {
    margin-top: 6px; width: 240px; padding: 10px; border-radius: 10px;
    background-color: var(--fundo-painel); border-width: 1px; border-color: var(--borda-clara);
}
.cam-title { font-size: 10px; letter-spacing: 1px; color: var(--texto-fraco); margin: 0 0 6px 2px; padding: 0; -unity-font-style: bold; }
.cam-opt { height: auto; padding: 6px 10px; margin: 0 0 4px 0; -unity-text-align: middle-left; white-space: normal; }
.cam-opt--on { border-color: var(--destaque); background-color: rgb(52, 48, 22); }
.cam-sub { margin: 6px 0 4px 0; }
.cam-pop .unity-base-field__label { min-width: 84px; width: 84px; }

/* Turbo no painel do jogador: a barra é o tanque e o botão */
.turbo { height: 22px; margin: 2px 0 6px 0; border-radius: 6px; border-width: 1px; border-color: var(--borda-media); background-color: rgb(14, 17, 16); overflow: hidden; justify-content: center; }
.turbo-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(40, 120, 200); }
.turbo-text { font-size: 10px; -unity-font-style: bold; color: var(--texto); -unity-text-align: middle-center; margin: 0; padding: 0; }
.turbo--on { border-color: rgb(140, 220, 255); }
.turbo--on .turbo-fill { background-color: rgb(90, 190, 255); }
.turbo--empty .turbo-text { color: var(--texto-fraco); }

/* Menu inicial: Opções e Sair */
.start-extra { flex-direction: row; justify-content: center; margin-top: 12px; }
.start-btn { height: 34px; min-width: 120px; margin: 0 6px; font-size: 13px; }

/* Teclas dos jogadores: tela de Opções, por cima do menu inicial (RaceController.BuildKeysUI) */
.keys-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.6); align-items: center; justify-content: center; }
.keys-card { width: 680px; max-width: 92%; padding: 16px; border-radius: 12px; background-color: var(--fundo-painel); border-width: 1px; border-color: var(--borda-clara); }
.keys-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.keys-who { width: 80px; flex-grow: 0; margin: 0 8px 0 0; }
.keys-btn { flex-grow: 1; flex-basis: 0; min-width: 0; height: 32px; margin: 0 6px 0 0; font-size: 11px; }
.keys-btn--wait { border-color: var(--destaque); background-color: rgb(52, 48, 22); }

/* Placar sobre a mesa (corrida): uma ficha por carrinho, o líder destacado */
.hud { flex-direction: row; margin-bottom: 8px; }
.hud-card {
    flex-direction: row; align-items: center; min-width: 170px; margin: 0 4px; padding: 6px 12px 6px 8px;
    border-radius: 10px; background-color: rgba(22, 28, 25, 0.92); border-width: 1px; border-color: var(--borda);
}
.hud-card--lead { border-color: var(--destaque); }
.hud-pos { font-size: 18px; -unity-font-style: bold; color: var(--texto-fraco); width: 30px; margin: 0; padding: 0; -unity-text-align: middle-center; }
.hud-card--lead .hud-pos { color: var(--destaque); }
.hud-dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 8px 0 2px; }
.hud-name { font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; color: var(--texto); margin: 0; padding: 0; }
.hud-row { flex-direction: row; }
.hud-lap { font-size: 12px; color: var(--texto); margin: 0 10px 0 0; padding: 0; }
.hud-best { font-size: 12px; color: var(--texto-fraco); margin: 0; padding: 0; }

/* Contagem grande da largada, no meio da mesa */
.cd-box { position: absolute; top: 0; bottom: 0; right: 0; left: 0; align-items: center; justify-content: center; }
.cd-text {
    font-size: 140px; -unity-font-style: bold; color: rgb(224, 55, 44); margin: 0; padding: 0;
    -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(14, 17, 16);
}
.cd-text--go { color: var(--verde-luz); }
/* Corrida por tempo: aviso entre as manches, menor que a contagem e quebrando a linha. */
.cd-text--switch { font-size: 64px; color: var(--destaque); white-space: normal; -unity-text-align: middle-center; letter-spacing: 2px; }

/* Resultado da prova, dentro do aviso de vitória */
.res-table { margin-top: 10px; min-width: 380px; }
.res-row { flex-direction: row; align-items: center; padding: 6px 8px; margin-bottom: 4px; border-radius: 8px; background-color: rgb(30, 37, 33); }
.res-row--win { border-width: 1px; border-color: var(--destaque); }
.res-pos { width: 28px; font-size: 15px; -unity-font-style: bold; color: var(--destaque); margin: 0; padding: 0; }
.res-name { flex-grow: 1; font-size: 13px; -unity-font-style: bold; color: var(--texto); margin: 0 12px 0 0; padding: 0; }
.res-cell { font-size: 12px; color: var(--texto); margin: 0 0 0 12px; padding: 0; }
.res-cell--dim { color: var(--texto-fraco); }
.res-btns { flex-direction: row; justify-content: center; margin-top: 10px; }
.res-btn { height: 32px; margin: 0 4px; padding: 0 14px; }

/* Paleta em grupos */
.pal-group { font-size: 10px; letter-spacing: 1px; color: var(--texto-fraco); -unity-font-style: bold; margin: 8px 0 4px 2px; padding: 0; }

/* Selo de status sobre a mesa (construtor) */
.table-status-wrap { position: absolute; top: 10px; left: 0; right: 0; flex-direction: row; justify-content: center; }
.table-status {
    flex-direction: row; align-items: center;
    padding: 5px 6px 5px 12px; border-radius: 18px; background-color: var(--fundo-vidro);
    border-width: 1px; border-color: var(--borda-clara);
}
.table-status.status--ok { border-color: var(--verde-luz); }
.table-status.status--warn { border-color: var(--alerta); }
.table-status-text { font-size: 13px; color: var(--texto); margin: 0 8px 0 6px; padding: 0; }
.table-btn { height: 26px; margin: 0 0 0 4px; padding: 0 10px; border-radius: 13px; font-size: 12px; }

/* Barra de ações sobre a mesa (construtor) */
.action-bar {
    position: absolute; bottom: 10px; right: 12px; flex-direction: row; align-items: center; padding: 4px;
    border-radius: 10px; background-color: var(--fundo-vidro); border-width: 1px; border-color: var(--borda-clara);
}
.bar-btn { width: 34px; height: 32px; margin: 0 2px; padding: 0; font-size: 16px; -unity-text-align: middle-center; }
.bar-gap { width: 1px; height: 20px; margin: 0 4px; background-color: var(--borda-clara); }

/* Tela inicial */
.start {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;
    background-color: rgba(14, 17, 16, 0.82);
}
.start-card { width: 560px; padding: 28px 28px 20px 28px; border-radius: 16px; background-color: var(--fundo-painel); border-width: 1px; border-color: var(--borda-clara); }
.start-title { font-size: 40px; -unity-font-style: bold; letter-spacing: 6px; color: var(--destaque); margin: 0; padding: 0; -unity-text-align: middle-center; }
.start-sub { font-size: 14px; color: var(--texto-fraco); margin: 4px 0 20px 0; padding: 0; -unity-text-align: middle-center; }
.start-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.start-opt {
    width: 49%; height: 84px; margin: 0 0 10px 0; padding: 10px 14px; flex-direction: row; align-items: center;
    border-radius: 12px; border-width: 1px; border-color: var(--borda-media); background-color: var(--fundo-campo);
}
.start-opt:hover { border-color: var(--destaque); background-color: rgb(42, 43, 28); }
.start-icon { font-size: 28px; color: var(--destaque); width: 40px; margin: 0 10px 0 0; padding: 0; -unity-text-align: middle-center; }
.start-texts { flex-shrink: 1; flex-grow: 1; }
.start-opt-title { font-size: 17px; -unity-font-style: bold; color: var(--texto); margin: 0; padding: 0; -unity-text-align: middle-left; }
.start-opt-sub { font-size: 11px; color: var(--texto-fraco); margin: 2px 0 0 0; padding: 0; white-space: normal; -unity-text-align: middle-left; }
.start-foot { font-size: 11px; color: var(--texto-fraco); margin: 8px 0 0 0; padding: 0; -unity-text-align: middle-center; }

/* Lista de amigos da Steam: altura máxima, rolagem própria e o excedente cortado */
.lista-pistas { max-height: 300px; flex-shrink: 1; }

.friends-scroll {
    max-height: 240px; overflow: hidden; border-radius: 8px; padding: 4px 4px 0 4px;
    border-width: 1px; border-color: var(--borda); background-color: var(--fundo-fundo);
}
.friends-scroll .lib-item { margin-bottom: 4px; }
